eWarningCount":0},{"filePath":"129","messages":"130","suppressedMessages":"131","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"132","messages":"133","suppressedMessages":"134","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"135","messages":"136","suppressedMessages":"137","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"138","messages":"139","suppressedMessages":"140","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"141","messages":"142","suppressedMessages":"143","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"144","messages":"145","suppressedMessages":"146","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"147","messages":"148","suppressedMessages":"149","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"150","messages":"151","suppressedMessages":"152","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"153","messages":"154","suppressedMessages":"155","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"156"},{"filePath":"157","messages":"158","suppressedMessages":"159","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"160","messages":"161","suppressedMessages":"162","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"163","messages":"164","suppressedMessages":"165","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"166","messages":"167","suppressedMessages":"168","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"F:\\Original\\Original\\frontend\\src\\index.js",[],[],"F:\\Original\\Original\\frontend\\src\\reportWebVitals.js",[],[],"F:\\Original\\Original\\frontend\\src\\App.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\AttendanceList.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Home.js",["169"],["170"],"import React, { useContext, useEffect } from 'react'\r\nimport { useNavigate } from 'react-router-dom'\r\nimport graduate from './image/graduate.png'\r\nimport admin from './image/management.png'\r\nimport whitemang from './image/whitemang.png'\r\nimport dgraduate from './image/dgraduate.png'\r\nimport dcamera from './image/dcamera.png'\r\nimport wcamera from './image/wcamera.png'\r\nimport AttendancenSApi from '../ContextAPi/AttendanceSApi'\r\n\r\nconst Home = () => {\r\n  const context = useContext(AttendancenSApi)\r\n  const { bgcolor } = context\r\n  const navigate = useNavigate()\r\n  const isDark = bgcolor === 'dark'\r\n\r\n  useEffect(() => {\r\n    if (localStorage.getItem('token')) {\r\n      navigate('/admindata')\r\n    } else if (localStorage.getItem('student')) {\r\n      // student session exists; add redirect here if needed\r\n    }\r\n    // eslint-disable-next-line\r\n  }, [])\r\n\r\n  // Tailwind can't see class names built with template strings,\r\n  // so every class is written out in full here.\r\n  const cards = [\r\n    {\r\n      title: 'My Profile',\r\n      text: 'View or edit your profile details.',\r\n      icon: isDark ? whitemang : admin,\r\n      path: '/admin',\r\n      border: 'border-t-blue-500',\r\n      ring: 'bg-blue-500/15',\r\n      focus: 'focus-visible:ring-blue-500',\r\n    },\r\n    {\r\n      title: 'Student Login',\r\n      text: 'Sign in or create a new student account.',\r\n      icon: isDark ? dgraduate : graduate,\r\n      path: '/student',\r\n      border: 'border-t-emerald-500',\r\n      ring: 'bg-emerald-500/15',\r\n      focus: 'focus-visible:ring-emerald-500',\r\n    },\r\n    {\r\n      title: 'Attendance',\r\n      text: 'Check attendance for all students.',\r\n      icon: isDark ? dcamera : wcamera,\r\n      path: '/camera',\r\n      border: 'border-t-amber-500',\r\n      ring: 'bg-amber-500/15',\r\n      focus: 'focus-visible:ring-amber-500',\r\n    },\r\n  ]\r\n\r\n  const pageText = isDark ? 'text-slate-100' : 'text-slate-800'\r\n  const subText = isDark ? 'text-slate-400' : 'text-slate-500'\r\n  const pageBg = isDark\r\n    ? 'bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950'\r\n    : 'bg-gradient-to-br from-slate-50 via-white to-blue-50'\r\n  const cardBg = isDark\r\n    ? 'bg-slate-800/60 ring-1 ring-white/10 backdrop-blur'\r\n    : 'bg-white ring-1 ring-slate-200'\r\n  const navBtn = isDark\r\n    ? 'border-slate-600 text-slate-200 hover:bg-slate-700'\r\n    : 'border-slate-300 text-slate-700 hover:bg-slate-100'\r\n\r\n  return (\r\n    <div className={`min-h-screen ${pageBg}`}>\r\n    <div className=\"mx-auto max-w-6xl px-4 py-8\">\r\n      {/* Back / Forward */}\r\n      {/* <div className=\"mb-8 flex gap-2\">\r\n        <button\r\n          type=\"button\"\r\n          onClick={() => navigate(-1)}\r\n          aria-label=\"Go back\"\r\n          className={`rounded-full border px-4 py-1.5 text-sm transition-colors ${navBtn}`}\r\n        >\r\n          &#8592; Back\r\n        </button>\r\n        <button\r\n          type=\"button\"\r\n          onClick={() => navigate(1)}\r\n          aria-label=\"Go forward\"\r\n          className={`rounded-full border px-4 py-1.5 text-sm transition-colors ${navBtn}`}\r\n        >\r\n          Forward &#8594;\r\n        </button>\r\n      </div> */}\r\n\r\n      {/* Cards */}\r\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3\">\r\n        {cards.map((c) => (\r\n          <div\r\n            key={c.title}\r\n            role=\"button\"\r\n            tabIndex={0}\r\n            onClick={() => navigate(c.path)}\r\n            onKeyDown={(e) =>\r\n              (e.key === 'Enter' || e.key === ' ') && navigate(c.path)\r\n            }\r\n            className={`flex min-h-[15rem] cursor-pointer flex-col items-center justify-center rounded-2xl border-t-4 p-6 text-center shadow-md outline-none transition duration-200 hover:-translate-y-1.5 hover:shadow-xl focus-visible:ring-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0 ${cardBg} ${c.border} ${c.focus}`}\r\n          >\r\n            <div\r\n              className={`flex h-22 w-22 items-center justify-center rounded-full ${c.ring}`}\r\n              style={{ width: '5.5rem', height: '5.5rem' }}\r\n            >\r\n              <img src={c.icon} alt=\"\" className=\"h-13 w-13 object-contain\" style={{ width: '3.2rem', height: '3.2rem' }} />\r\n            </div>\r\n            <h5 className={`mb-1 mt-4 text-lg font-semibold ${pageText}`}>\r\n              {c.title}\r\n            </h5>\r\n            <p className={`text-sm ${subText}`}>{c.text}</p>\r\n          </div>\r\n        ))}\r\n      </div>\r\n    </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default Home","F:\\Original\\Original\\frontend\\src\\Component\\More.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Navbar.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\Admin.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\AdminSignup.js",[],["171"],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\Admininfo.js",[],["172"],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\AdminData.js",[],[],"F:\\Original\\Original\\frontend\\src\\ContextAPi\\AttendanceState.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Student\\Studentsign.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\AdminList.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\Studentlist.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\CamerA\\Camera.js",[],["173"],"F:\\Original\\Original\\frontend\\src\\Component\\Student\\Student.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Student\\CheckAttendance.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Student\\Studentdata.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Student\\StudentInfo.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Alerts.js",[],[],"F:\\Original\\Original\\frontend\\src\\config.js",[],[],"F:\\Original\\Original\\frontend\\src\\ContextAPi\\AttendanceSApi.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\AttendanceTable.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\Filters.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\Contactdetails.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\Basicdetails.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\Tablelist.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Admin\\EditList.js",["174"],[],"import React, { useRef, useState } from 'react'\nimport {apiUrl} from '../../config'\nconst API = `${apiUrl}api`\nconst MAX_PHOTO_MB = 5\n\n// `name` must match the field names on your student documents\nconst FIELDS = [\n  { name: 'name', label: 'Full name', type: 'text', full: true },\n  { name: 'email', label: 'Email', type: 'email', full: true },\n  { name: 'rollnumber', label: 'Roll no.', type: 'text' },\n  { name: 'currentedu', label: 'Course', type: 'text' },\n  { name: 'stdbranch', label: 'Branch', type: 'text' },\n  { name: 'currentyear', label: 'Year', type: 'text' },\n]\n\n// Shrinks the picked photo to max 400px and returns a JPEG data URL,\n// so the request body stays small.\nconst resizeImage = (file, max = 400) =>\n  new Promise((resolve, reject) => {\n    const url = URL.createObjectURL(file)\n    const img = new Image()\n    img.onload = () => {\n      const scale = Math.min(1, max / Math.max(img.width, img.height))\n      const canvas = document.createElement('canvas')\n      canvas.width = Math.round(img.width * scale)\n      canvas.height = Math.round(img.height * scale)\n      canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height)\n      URL.revokeObjectURL(url)\n      resolve(canvas.toDataURL('image/jpeg', 0.85))\n    }\n    img.onerror = () => {\n      URL.revokeObjectURL(url)\n      reject(new Error('Could not read image'))\n    }\n    img.src = url\n  })\n\n// Rendered inside <Modal> by Studentlist, so it only holds the form content.\n// Studentlist gives it key={student._id}, so the form starts from that student's values.\nconst Editlist = ({ student, isDark, onClose, onSaved, showAlert,widthClass = 'max-w-sm'}) => {\n  const fileRef = useRef(null)\n  const [form, setForm] = useState(() =>\n    FIELDS.reduce((acc, f) => ({ ...acc, [f.name]: student[f.name] != null ? String(student[f.name]) : '' }), {})\n  )\n  const [photo, setPhoto] = useState(student.image || '')\n  const [error, setError] = useState('')\n  const [saving, setSaving] = useState(false)\n\n  const photoChanged = photo !== (student.image || '')\n  const changed = photoChanged || FIELDS.some((f) => form[f.name].trim() !== String(student[f.name] ?? ''))\n\n  const onField = (e) => {\n    setForm((p) => ({ ...p, [e.target.name]: e.target.value }))\n    setError('')\n  }\n\n  const onPhoto = async (e) => {\n    const file = e.target.files && e.target.files[0]\n    e.target.value = '' // lets you pick the same file again\n    if (!file) return\n    if (!file.type.startsWith('image/')) return setError('Choose an image file (JPG, PNG or WebP).')\n    if (file.size > MAX_PHOTO_MB * 1024 * 1024) return setError(`Photo must be under ${MAX_PHOTO_MB} MB.`)\n    try {\n      setPhoto(await resizeImage(file))\n      setError('')\n    } catch (err) {\n      setError('Could not read that image. Try a different file.')\n    }\n  }\n\n  const handleSave = async (e) => {\n    e.preventDefault()\n    const payload = FIELDS.reduce((acc, f) => ({ ...acc, [f.name]: form[f.name].trim() }), {})\n    if (photoChanged) payload.image = photo // only sent when the photo was changed\n\n    if (payload.name.length < 2) return setError('Enter the student’s full name.')\n    if (!/^\\S+@\\S+\\.\\S+$/.test(payload.email)) return setError('Enter a valid email address.')\n\n    setSaving(true)\n    try {\n      const response = await fetch(`${API}/student/updatestudent/${student._id}`, {\n        method: 'PUT',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(payload),\n      })\n      const json = await response.json().catch(() => ({}))\n      if (!response.ok) {\n        setError(json.error || json.message || 'Could not save changes. Try again.')\n        setSaving(false)\n        return\n      }\n      onSaved({ ...student, ...payload })\n      if (showAlert) showAlert('Student details updated', 'success')\n      onClose()\n    } catch (err) {\n      setError('Could not reach the server. Check your connection and try again.')\n      setSaving(false)\n    }\n  }\n\n  // ---- theme classes (full strings so Tailwind can detect them) ----\n  const label = isDark ? 'text-slate-300' : 'text-slate-700'\n  const errorText = isDark ? 'text-rose-300' : 'text-rose-600'\n  const avatarRing = isDark ? 'ring-slate-900' : 'ring-white'\n  const avatarFallback = isDark ? 'bg-slate-800 text-slate-200' : 'bg-indigo-100 text-indigo-700'\n  const linkBtn = isDark ? 'text-indigo-300 hover:text-indigo-200' : 'text-indigo-600 hover:text-indigo-700'\n  const mutedBtn = isDark ? 'text-slate-400 hover:text-slate-200' : 'text-slate-500 hover:text-slate-700'\n  const input = isDark\n    ? 'bg-slate-800/80 text-slate-100 placeholder-slate-500 ring-1 ring-white/10'\n    : 'bg-white text-slate-900 placeholder-slate-400 ring-1 ring-slate-300'\n  const ghost = isDark\n    ? 'text-slate-200 ring-1 ring-white/15 hover:bg-slate-800'\n    : 'text-slate-700 ring-1 ring-slate-300 hover:bg-slate-100'\n  const focus = 'outline-none focus-visible:ring-4 focus-visible:ring-indigo-500/40'\n\n  const initial = (form.name || student.name || '?').trim().charAt(0).toUpperCase()\n\n  return (\n    <form onSubmit={handleSave} noValidate>\n      <div className=\"bg-gradient-to-br from-indigo-600 via-violet-600 to-fuchsia-600 px-6 pb-14 pt-6 text-white\">\n        <h2 id=\"edit-title\" className=\"text-lg font-semibold tracking-tight\">Update student</h2>\n        <p className=\"mt-1 text-sm text-indigo-100\">Edit the details below, then save.</p>\n      </div>\n\n      <div className=\"px-6 pb-6\">\n        {/* Photo picker */}\n        <div className=\"text-center\">\n          <input\n            ref={fileRef}\n            type=\"file\"\n            accept=\"image/*\"\n            onChange={onPhoto}\n            className=\"hidden\"\n            tabIndex={-1}\n          />\n          <button\n            type=\"button\"\n            onClick={() => fileRef.current && fileRef.current.click()}\n            disabled={saving}\n            aria-label=\"Change photo\"\n            className={`group relative -mt-12 mx-auto flex h-24 w-24 items-center justify-center overflow-hidden rounded-full text-3xl font-semibold ring-4 ${avatarRing} ${avatarFallback} ${focus}`}\n          >\n            {photo ? (\n              <img src={photo} alt=\"Student photo\" className=\"h-full w-full object-cover\" />\n            ) : (\n              initial\n            )}\n            <span className=\"absolute inset-0 flex items-center justify-center bg-slate-950/50 text-white opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100\">\n              <svg className=\"h-6 w-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.8\" strokeLinecap=\"round\" strokeLinejoin=\"round\" aria-hidden=\"true\">\n                <path d=\"M4 8h3l2-3h6l2 3h3v11H4z\" />\n                <circle cx=\"12\" cy=\"13\" r=\"3.5\" />\n              </svg>\n            </span>\n          </button>\n\n          <div className=\"mt-2 flex items-center justify-center gap-3 text-sm font-medium\">\n            <button\n              type=\"button\"\n              onClick={() => fileRef.current && fileRef.current.click()}\n              disabled={saving}\n              className={`rounded-lg px-1 transition ${linkBtn} ${focus}`}\n            >\n              Change photo\n            </button>\n            {photoChanged && (\n              <button\n                type=\"button\"\n                onClick={() => setPhoto(student.image || '')}\n                disabled={saving}\n                className={`rounded-lg px-1 transition ${mutedBtn} ${focus}`}\n              >\n                Undo\n              </button>\n            )}\n          </div>\n        </div>\n\n        <div className=\"mt-5 grid gap-4 sm:grid-cols-2\">\n          {FIELDS.map((f, i) => (\n            <div key={f.name} className={f.full ? 'sm:col-span-2' : ''}>\n              <label htmlFor={`edit-${f.name}`} className={`mb-1.5 block text-sm font-medium ${label}`}>\n                {f.label}\n              </label>\n              <input\n                id={`edit-${f.name}`}\n                name={f.name}\n                type={f.type}\n                value={form[f.name]}\n                onChange={onField}\n                disabled={saving}\n                autoFocus={i === 0}\n                className={`w-full rounded-2xl px-4 py-3 text-sm disabled:opacity-60 ${input} ${focus}`}\n              />\n            </div>\n          ))}\n        </div>\n\n        <p role=\"alert\" aria-live=\"polite\" className={`mt-4 min-h-[1.25rem] text-sm ${errorText}`}>\n          {error}\n        </p>\n\n        <div className=\"mt-4 grid grid-cols-2 gap-3\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            disabled={saving}\n            className={`h-11 rounded-2xl text-sm font-medium transition ${ghost} ${focus}`}\n          >\n            Cancel\n          </button>\n          <button\n            type=\"submit\"\n            disabled={saving || !changed}\n            className={`h-11 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 text-sm font-medium text-white shadow-md shadow-indigo-600/30 transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-50 ${focus}`}\n          >\n            {saving ? 'Saving…' : 'Save changes'}\n          </button>\n        </div>\n      </div>\n    </form>\n  )\n}\n\nexport default Editlist","F:\\Original\\Original\\frontend\\src\\Component\\Student\\StudentContact.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Student\\FamilyDetail.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Student\\CheckTable.js",[],[],"F:\\Original\\Original\\frontend\\src\\Component\\Student\\Studenedu.js",[],[],{"ruleId":"175","severity":1,"message":"176","line":66,"column":9,"nodeType":"177","messageId":"178","endLine":66,"endColumn":15},{"ruleId":"179","severity":1,"message":"180","line":24,"column":6,"nodeType":"181","endLine":24,"endColumn":8,"suggestions":"182","suppressions":"183"},{"ruleId":"179","severity":1,"message":"180","line":82,"column":6,"nodeType":"181","endLine":82,"endColumn":8,"suggestions":"184","suppressions":"185"},{"ruleId":"179","severity":1,"message":"186","line":176,"column":6,"nodeType":"181","endLine":176,"endColumn":23,"suggestions":"187","suppressions":"188"},{"ruleId":"179","severity":1,"message":"189","line":132,"column":6,"nodeType":"181","endLine":132,"endColumn":16,"suggestions":"190","suppressions":"191"},{"ruleId":"192","severity":1,"message":"193","line":144,"column":15,"nodeType":"194","endLine":144,"endColumn":93},"no-unused-vars","'navBtn' is assigned a value but never used.","Identifier","unusedVar","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'navigate'. Either include it or remove the dependency array.","ArrayExpression",["195"],["196"],["197"],["198"],"React Hook useEffect has a missing dependency: 'cancelEdit'. Either include it or remove the dependency array.",["199"],["200"],"React Hook useEffect has a missing dependency: 'handleResult'. Either include it or remove the dependency array.",["201"],["202"],"jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","JSXOpeningElement",{"desc":"203","fix":"204"},{"kind":"205","justification":"206"},{"desc":"203","fix":"207"},{"kind":"205","justification":"206"},{"desc":"208","fix":"209"},{"kind":"205","justification":"206"},{"desc":"210","fix":"211"},{"kind":"205","justification":"206"},"Update the dependencies array to be: [navigate]",{"range":"212","text":"213"},"directive","",{"range":"214","text":"213"},"Update the dependencies array to be: [cancelEdit, editing, saving]",{"range":"215","text":"216"},"Update the dependencies array to be: [handleResult, scanning]",{"range":"217","text":"218"},[857,859],"[navigate]",[2043,2045],[5530,5547],"[cancelEdit, editing, saving]",[4727,4737],"[handleResult, scanning]"]